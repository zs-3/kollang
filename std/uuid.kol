-- UUID v4 generator. Seed once per process with rand_seed_time().
use std.str
extern fn kol_uuid_v4() -> str from "kol_runtime"

fn uuid_v4() -> str
    return kol_uuid_v4()
end

fn uuid_is_valid(value: str) -> bool
    if value.len() != 36 return false end
    mut i = 0
    while i < 36
        let c = value.slice(i, i + 1).lower()
        if i == 8 or i == 13 or i == 18 or i == 23
            if c != "-" return false end
        else
            let k = char_code(c)
            if not ((k >= 48 and k <= 57) or (k >= 97 and k <= 102)) return false end
        end
        i = i + 1
    end
    return true
end
