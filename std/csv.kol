-- CSV helpers. Handles quoted fields, escaped double quotes, CRLF and embedded newlines.
fn csv_parse_row(line: str) -> [str]
    mut fields: [str] = []
    mut field = ""
    mut quoted = false
    mut i = 0
    while i < line.len()
        let ch = line.slice(i, i + 1)
        if quoted
            if ch == "\""
                if i + 1 < line.len() and line.slice(i + 1, i + 2) == "\""
                    field = field + "\""
                    i = i + 1
                else
                    quoted = false
                end
            else
                field = field + ch
            end
        else
            if ch == ","
                fields.push(field)
                field = ""
            elif ch == "\"" and field.len() == 0
                quoted = true
            else
                field = field + ch
            end
        end
        i = i + 1
    end
    fields.push(field)
    return fields
end

fn csv_escape_field(value: str) -> str
    if value.contains(",") or value.contains("\"") or value.contains("\n") or value.contains("\r")
        return "\"" + value.replace("\"", "\"\"") + "\""
    end
    return value
end

fn csv_encode_row(fields: [str]) -> str
    mut out = ""
    mut first = true
    for field in fields
        if not first out = out + "," end
        out = out + csv_escape_field(field)
        first = false
    end
    return out
end

fn csv_parse_document(document: str) -> [[str]]
    mut rows: [[str]] = []
    mut row: [str] = []
    mut field = ""
    mut quoted = false
    mut i = 0
    while i < document.len()
        let ch = document.slice(i, i + 1)
        if quoted
            if ch == "\""
                if i + 1 < document.len() and document.slice(i + 1, i + 2) == "\""
                    field = field + "\""
                    i = i + 1
                else
                    quoted = false
                end
            else
                field = field + ch
            end
        else
            if ch == "\"" and field.len() == 0
                quoted = true
            elif ch == ","
                row.push(field)
                field = ""
            elif ch == "\n" or ch == "\r"
                row.push(field)
                rows.push(row)
                row = []
                field = ""
                if ch == "\r" and i + 1 < document.len() and document.slice(i + 1, i + 2) == "\n"
                    i = i + 1
                end
            else
                field = field + ch
            end
        end
        i = i + 1
    end
    if field.len() > 0 or row.len() > 0 or document.len() == 0
        row.push(field)
        rows.push(row)
    end
    return rows
end

fn csv_encode_document(rows: [[str]]) -> str
    mut out = ""
    mut first = true
    for row in rows
        if not first out = out + "\r\n" end
        out = out + csv_encode_row(row)
        first = false
    end
    return out
end

-- Header-aware helpers. Row values are indexed by the same header array.
fn csv_column_index(headers: [str], name: str) -> int
    mut i = 0
    for header in headers
        if header == name return i end
        i = i + 1
    end
    return -1
end

fn csv_row_get(row: [str], headers: [str], name: str) -> str
    let index = csv_column_index(headers, name)
    if index < 0 or index >= row.len() return "" end
    return row[index]
end

fn csv_row_get_or(row: [str], headers: [str], name: str, fallback: str) -> str
    let index = csv_column_index(headers, name)
    if index < 0 or index >= row.len() return fallback end
    return row[index]
end

-- Retrieve a data row by zero-based index, using the first row as headers.
fn csv_document_get(document: str, row_index: int, column_name: str) -> str
    if row_index < 0 return "" end
    let rows = csv_parse_document(document)
    if rows.len() == 0 or row_index + 1 >= rows.len() return "" end
    return csv_row_get(rows[row_index + 1], rows[0], column_name)
end

fn csv_document_get_or(document: str, row_index: int, column_name: str, fallback: str) -> str
    if row_index < 0 return fallback end
    let rows = csv_parse_document(document)
    if rows.len() == 0 or row_index + 1 >= rows.len() return fallback end
    return csv_row_get_or(rows[row_index + 1], rows[0], column_name, fallback)
end
