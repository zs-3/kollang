-- std/list.kol

use std.array

fn sum_list(nums: [int]) -> int
    return sum_array(nums)
end

fn product_list(nums: [int]) -> int
    return product_array(nums)
end

fn max_in_list(nums: [int]) -> int
    let mx = max_array(nums) or 0
    return mx
end

fn min_in_list(nums: [int]) -> int
    let mn = min_array(nums) or 0
    return mn
end

fn list_contains_int(lst: [int], val: int) -> bool
    return array_contains(lst, val)
end

fn list_index_of(lst: [int], val: int) -> int
    return array_index_of(lst, val)
end

fn sort_list_int(lst: [int]) -> [int]
    return sort_int_array(lst)
end
