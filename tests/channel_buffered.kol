-- Bounded channels, close(), 'for v in channel' and string messages.
task fn count_to(ch: channel(int), n: int)
    for i in 1..=n
        ch.send(i)
    end
    ch.close()
end

task fn name_source(ch: channel(str))
    ch.send("alpha")
    ch.send("a name that needs the heap")
    ch.send("gamma")
    ch.close()
end

fn main()
    let ch = channel(int, 8)
    print(ch.cap())
    print(ch.len())
    let p = spawn count_to(ch, 1000)
    mut sum = 0
    for v in ch
        sum = sum + v
    end
    await p
    print(sum)
    print(ch.is_closed())

    let names = channel(str, 2)
    let q = spawn name_source(names)
    for n in names
        print(n)
    end
    await q

    -- a closed, drained channel yields zero values instead of blocking
    let z = ch.receive()
    print(z)

    -- default capacity is 1
    let one = channel(int)
    print(one.cap())
    one.send(5)
    print(one.len())
    print(one.receive())
end
