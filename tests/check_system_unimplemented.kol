#!/usr/bin/env python3
import sys
import os
import subprocess

def test_check_system_unimplemented():
    tmp_kol = "/tmp/check_system_tmp.kol"
    with open(tmp_kol, "w") as f:
        f.write("""fn main()
    system
        let buf = mem.alloc(64)
        mem.free(buf)
    end
end
""")

    cmd = [sys.executable, "kol.py", "check", tmp_kol]
    res = subprocess.run(cmd, capture_output=True, text=True)

    if os.path.exists(tmp_kol):
        os.remove(tmp_kol)

    if res.returncode != 0:
        print(f"FAIL: Expected 'kol check' on system block to succeed, but failed with:\n{res.stderr}")
        sys.exit(1)

    print("PASS: check_system on system block succeeded.")

if __name__ == "__main__":
    test_check_system_unimplemented()
