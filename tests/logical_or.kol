fn f1(a: int) -> bool
    if a == 1 or a == 2
        return true
    end
    return false
end
fn f2(a: int) -> bool
    return a == 1 or a == 2
end
fn f3(a: int) -> bool
    return a < 0 || a > 10
end
fn parse(s: str) -> int!
    if s == "bad" fail "bad" end
    return 5
end
fn flag(s: str) -> bool!
    if s == "bad" fail "bad" end
    return true
end
print(f1(2))
print(f1(5))
print(f2(2))
print(f2(5))
print(f3(11))
print(f3(5))
print(1 < 2 and 2 < 3 or false)
print(parse("bad") or 99)
print(parse("ok") or 99)
print(flag("bad") or false)
print(flag("ok") or false)
let s = "hello"
print(s.starts_with("x") or s.ends_with("o"))
let b = false
print(b or true)
