use std.url
use std.core

assert_eq_bool(url_has_scheme("https://example.com/path"), true, "absolute URL scheme")
assert_eq_bool(url_has_scheme("1abc:thing"), false, "invalid scheme start")
assert_eq_str(url_scheme("HTTPS://example.com/a"), "https", "normalized scheme")
assert_eq_str(url_host("https://user:pass@example.com:8443/a?q=1#x"), "example.com:8443", "authority without user info")
assert_eq_str(url_hostname("https://example.com:8443/a"), "example.com", "hostname")
assert_eq_int(url_port("https://example.com:8443/a"), 8443, "port")
assert_eq_str(url_path("https://example.com/a/b?q=1"), "/a/b?q=1", "path includes query in current API")
assert_eq_str(url_query_param("https://example.com/?q=kol&page=2", "q"), "kol", "query value")
assert_eq_str(url_query_param("https://example.com/?q=a%26b", "q"), "a&b", "decoded query value")
assert_eq_bool(url_has_query_param("https://example.com/?empty=&flag", "empty"), true, "empty value still exists")
assert_eq_bool(url_has_query_param("https://example.com/?empty=&flag", "missing"), false, "missing key")
assert_eq_str(url_query_param_or("https://example.com/?empty=", "empty", "fallback"), "", "present empty value")
assert_eq_str(url_query_param_or("https://example.com/", "missing", "fallback"), "fallback", "fallback for missing key")
assert_eq_int(url_query_param_count("https://example.com/?tag=a&tag=b&tag=c", "tag"), 3, "duplicate parameter count")
assert_eq_str(url_fragment("https://example.com/a?q=1#section"), "section", "fragment")
assert_eq_str(url_strip_query("https://example.com/a?q=1#section"), "https://example.com/a", "strip query and fragment")

let all_tags = url_query_param_all("https://example.com/?tag=one&tag=two%20words&flag", "tag")
assert_eq_int(all_tags.len(), 2, "all repeated query values count")
assert_eq_str(all_tags[0], "one", "first repeated query value")
assert_eq_str(all_tags[1], "two words", "second repeated query value decoded")
let added_query = url_query_add("https://example.com/path?x=1#section", "new key", "two words&more")
assert_eq_str(added_query, "https://example.com/path?x=1&new+key=two+words%26more#section", "append query before fragment")
let added_first = url_query_add("https://example.com/path#section", "q", "hello world")
assert_eq_str(added_first, "https://example.com/path?q=hello+world#section", "append first query before fragment")
assert_eq_str(url_query_escape("a b c"), "a+b+c", "query escape multiple spaces")
assert_eq_str(url_query_add("https://example.com/path?", "q", "x"), "https://example.com/path?q=x", "append query after empty query marker")
print("URL TESTS PASSED")
let removed_query = url_query_remove("https://example.com/p?a=1&tag=x&tag=y&b=2#f", "tag")
assert_eq_str(removed_query, "https://example.com/p?a=1&b=2#f", "remove repeated query key")
let removed_only = url_query_remove("https://example.com/p?tag=x#f", "tag")
assert_eq_str(removed_only, "https://example.com/p#f", "remove only query key")
let set_query = url_query_set("https://example.com/p?tag=old&x=1&tag=older#f", "tag", "new value")
assert_eq_str(set_query, "https://example.com/p?x=1&tag=new+value#f", "set replaces all matching query keys")
