use std.core
use std.math
assert_eq_float(sqrt(16.0), 4.0, 0.000001, "sqrt")
assert_eq_float(pow(2.0, 10.0), 1024.0, 0.000001, "pow")
assert_eq_float(hypot(3.0, 4.0), 5.0, 0.000001, "hypot")
assert_eq_float(atan2(1.0, 1.0) * 4.0, PI, 0.000001, "atan2")
assert_eq_int(floor_int(-2.5), -3, "floor_int")
assert_eq_int(ceil_int(2.1), 3, "ceil_int")
assert_eq_int(round_int(2.5), 3, "round_int")
assert_eq_int(to_int(-3.9), -3, "to_int truncates")
assert_eq_float(to_float(7) / 2.0, 3.5, 0.000001, "to_float")
assert_eq_int(isqrt(99), 9, "isqrt 99")
assert_eq_int(isqrt(100), 10, "isqrt 100")
assert_true(is_perfect_square(144), "perfect square")
assert_eq_int(pow_mod(2, 10, 1000), 24, "pow_mod")
assert_eq_int(binomial(10, 3), 120, "binomial")
assert_eq_int(digit_sum(12345), 15, "digit_sum")
assert_eq_int(count_digits(0), 1, "count_digits 0")
assert_eq_int(next_prime(13), 17, "next_prime")
let pf: [int] = prime_factors(360)
assert_eq_int(pf.len(), 6, "prime_factors len")
assert_eq_int(fib_fast(30), 832040, "fib_fast")
assert_true(is_power_of_two(64), "pow2 yes")
assert_true(not is_power_of_two(48), "pow2 no")
assert_true(is_close(0.1 + 0.2, 0.3, 0.000001), "is_close")
assert_eq_int(sign_float(-2.5), -1, "sign_float")
assert_eq_float(lerp(10.0, 20.0, 0.25), 12.5, 0.000001, "lerp")
assert_eq_float(clamp_float(5.0, 0.0, 1.0), 1.0, 0.000001, "clamp_float")
print("MATH EXTRA TESTS PASSED")
