use std.core
use std.format
use std.encoding
use std.text
assert_eq_str(format_fixed(3.14159, 2), "3.14", "fixed")
assert_eq_str(format_fixed(2.0, 0), "2", "fixed0")
assert_eq_str(format_fixed(-0.5, 1), "-0.5", "fixed neg")
assert_eq_str(format_fixed(0.05, 1), "0.1", "fixed round")
assert_eq_str(format_thousands(1234567), "1,234,567", "thousands")
assert_eq_str(format_thousands(-999), "-999", "thousands small")
assert_eq_str(format_percent(0.256, 1), "25.6%", "percent")
assert_eq_str(format_bytes(512), "512 B", "bytes small")
assert_eq_str(format_bytes(1536), "1.5 KB", "bytes kb")
assert_eq_str(format_duration(3725), "1h 2m 5s", "duration")
assert_eq_str(format_hex(255, 4), "00ff", "format_hex")
assert_eq_str(hex_encode("Hi!"), "486921", "hex enc")
assert_eq_str(hex_decode("486921") or "ERR", "Hi!", "hex dec")
assert_eq_str(base64_encode("Man"), "TWFu", "b64 3")
assert_eq_str(base64_encode("Ma"), "TWE=", "b64 2")
assert_eq_str(base64_encode("M"), "TQ==", "b64 1")
assert_eq_str(base64_encode("hello world"), "aGVsbG8gd29ybGQ=", "b64 hello")
assert_eq_str(base64_decode("aGVsbG8gd29ybGQ=") or "ERR", "hello world", "b64 dec")
assert_eq_str(base64_decode("!!!!") or "ERR", "ERR", "b64 bad")
assert_eq_str(url_encode("a b&c=d/é"), "a%20b%26c%3Dd%2F%C3%A9", "url enc")
assert_eq_str(url_decode("a%20b%26c+d") or "ERR", "a b&c d", "url dec")
assert_eq_str(url_decode("bad%2") or "ERR", "ERR", "url trunc")
assert_eq_int(levenshtein("kitten", "sitting"), 3, "lev")
assert_eq_int(levenshtein("", "abc"), 3, "lev empty")
let wrapped: [str] = word_wrap("the quick brown fox jumps over", 10)
assert_eq_int(wrapped.len(), 3, "wrap lines")
assert_eq_str(wrapped[0], "the quick", "wrap 0")
assert_eq_int(count_words(" a  b c "), 3, "count_words")
assert_eq_int(count_lines("a\nb\n"), 2, "count_lines")
assert_eq_str(common_prefix("flower", "flow"), "flow", "prefix")
assert_eq_str(to_snake_case("Hello Big-World"), "hello_big_world", "snake")
assert_eq_str(to_camel_case("hello big_world"), "helloBigWorld", "camel")
print("FORMAT ENCODING TEXT TESTS PASSED")
