use std.core
use std.str
assert_eq_int(char_code("A"), 65, "char_code")
assert_eq_str(char_from_code(122), "z", "chr")
assert_eq_str(char_at("hello", 1), "e", "char_at")
assert_true(is_digit_char("7"), "digit")
assert_true(not is_digit_char("a"), "not digit")
assert_true(is_alpha_char("Q"), "alpha")
assert_true(is_space_char(" "), "space")
assert_true(is_punct_char("!"), "punct")
assert_true(is_blank("   "), "blank")
assert_true(is_all_digits("12345"), "all digits")
assert_true(not is_all_digits("12a45"), "not all digits")
assert_true(is_palindrome("racecar"), "palin")
assert_eq_int(index_of("hello world", "o"), 4, "index_of")
assert_eq_int(index_of_from("hello world", "o", 5), 7, "index_of_from")
assert_eq_int(count_substr("banana", "an"), 2, "count")
assert_eq_int(count_substr("aaaa", "aa"), 2, "count nonoverlap")
assert_eq_int(str_compare("apple", "banana"), -1, "cmp lt")
assert_eq_int(str_compare("b", "a"), 1, "cmp gt")
assert_eq_int(str_compare("same", "same"), 0, "cmp eq")
assert_eq_str(capitalize("hELLO"), "Hello", "capitalize")
assert_eq_str(swap_case("aBc"), "AbC", "swap_case")
assert_eq_str(title_case("hello big world"), "Hello Big World", "title")
assert_eq_str(center_str("ab", 6, "*"), "**ab**", "center")
assert_eq_str(truncate_str("hello world", 8, "..."), "hello...", "truncate")
assert_eq_str(strip_prefix("foobar", "foo"), "bar", "strip_prefix")
assert_eq_str(strip_suffix("foobar", "bar"), "foo", "strip_suffix")
assert_eq_str(replace_first("a-a-a", "a", "X"), "X-a-a", "replace_first")
assert_eq_str(str_between("x[abc]y", "[", "]"), "abc", "between")
let chars: [str] = str_chars("abc")
assert_eq_int(chars.len(), 3, "chars len")
assert_eq_str(chars[2], "c", "chars[2]")
let lines: [str] = str_lines("a\nb\nc")
assert_eq_int(lines.len(), 3, "lines len")
let words: [str] = str_words("  the quick   brown fox ")
assert_eq_int(words.len(), 4, "words len")
assert_eq_str(words[1], "quick", "words[1]")
print("STR EXTRA TESTS PASSED")
