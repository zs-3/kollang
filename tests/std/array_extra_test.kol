use std.core
use std.array
let a = [5, 2, 9, 1, 5, 6]
let s: [int] = sort_int_array(a)
assert_eq_int(a[0], 5, "input not mutated")
assert_eq_int(s[0], 1, "sorted[0]")
assert_eq_int(s[5], 9, "sorted[5]")
assert_true(array_is_sorted(s), "is_sorted")
let r: [int] = array_reverse_copy(a)
assert_eq_int(r[0], 6, "reverse")
assert_eq_int(a[0], 5, "reverse not mutating")
let sl: [int] = array_slice(a, 1, 3)
assert_eq_int(sl.len(), 2, "slice len")
assert_eq_int(sl[0], 2, "slice[0]")
let rg: [int] = array_range(0, 5)
assert_eq_int(rg.len(), 5, "range len")
let u: [int] = array_unique(a)
assert_eq_int(u.len(), 5, "unique")
assert_eq_int(array_binary_search(s, 6), 4, "bsearch")
assert_eq_int(array_count(a, 5), 2, "count")
let ins: [int] = array_insert_at(a, 1, 100)
assert_eq_int(ins[1], 100, "insert")
assert_eq_int(ins.len(), 7, "insert len")
let rem: [int] = array_remove_at(a, 0)
assert_eq_int(rem[0], 2, "remove")
let fl = [3.5, 1.5, 2.5]
let sf: [float] = sort_float_array(fl)
assert_eq_float(sf[0], 1.5, 0.0001, "sort float")
assert_eq_float(float_array_sum(fl), 7.5, 0.0001, "float sum")
let names = ["pear", "apple", "fig"]
let sn: [str] = sort_str_array(names)
assert_eq_str(sn[0], "apple", "sort str 0")
assert_eq_str(sn[2], "pear", "sort str 2")
assert_eq_str(names[0], "pear", "names untouched")
assert_eq_int(str_array_index_of(names, "fig"), 2, "str idx")
let rs: [int] = array_range_step(10, 0, -3)
assert_eq_int(rs.len(), 4, "range step down")
print("ARRAY EXTRA TESTS PASSED")
let fd = sort_float_array_desc(fl)
assert_eq_float(fd[0], 3.5, 0.0001, "sort float desc")
assert_true(float_array_contains(fl, 2.5), "float contains")
assert_eq_int(float_array_index_of(fl, 1.5), 1, "float index")
let fr = float_array_reverse_copy(fl)
assert_eq_float(fr[0], 2.5, 0.0001, "float reverse")
let fc = float_array_concat(fl, [9.5])
assert_eq_int(fc.len(), 4, "float concat")
assert_eq_int(float_array_slice(fl, 1, 3).len(), 2, "float slice")
assert_eq_int(float_array_take(fl, 2).len(), 2, "float take")
assert_eq_int(float_array_drop(fl, 2).len(), 1, "float drop")
assert_eq_int(float_array_unique([1.0, 1.0, 2.0]).len(), 2, "float unique")
assert_true(float_array_equals([1.0, 2.0], [1.0, 2.0]), "float equals")
assert_eq_int(str_array_count(names, "pear"), 1, "str count")
assert_true(str_array_equals(["a", "b"], ["a", "b"]), "str equals")
assert_true(str_array_is_sorted(sn), "str sorted")
assert_eq_int(str_array_take(names, 2).len(), 2, "str take")
assert_eq_int(str_array_drop(names, 1).len(), 2, "str drop")
let names_removed = str_array_remove_at(names, 1)
assert_eq_str(names_removed[1], "fig", "str remove")
let names_inserted = str_array_insert_at(names, 1, "kiwi")
assert_eq_str(names_inserted[1], "kiwi", "str insert")
let names_desc = sort_str_array_desc(names)
assert_eq_str(names_desc[0], "pear", "str descending sort")
print("ARRAY COLLECTION EXPANSION PASSED")
