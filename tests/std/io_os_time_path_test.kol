use std.core
use std.io
use std.os
use std.time
use std.path
assert_true(write_file("/tmp/kol_io_test.txt", "alpha\nbeta\ngamma\n"), "write")
assert_true(file_exists("/tmp/kol_io_test.txt"), "exists")
assert_eq_int(file_size("/tmp/kol_io_test.txt"), 17, "size")
let text = read_file("/tmp/kol_io_test.txt") or "FAIL"
assert_eq_str(text, "alpha\nbeta\ngamma\n", "read back")
assert_true(append_file("/tmp/kol_io_test.txt", "delta\n"), "append")
let lines: [str] = read_file_lines("/tmp/kol_io_test.txt")
assert_eq_int(lines.len(), 5, "line count incl trailing empty")
assert_eq_str(lines[3], "delta", "line 3")
let missing = read_file("/tmp/definitely_missing.txt") or "MISSING"
assert_eq_str(missing, "MISSING", "missing file fails")
assert_true(copy_file("/tmp/kol_io_test.txt", "/tmp/kol_io_copy.txt"), "copy")
assert_true(rename_file("/tmp/kol_io_copy.txt", "/tmp/kol_io_moved.txt"), "rename")
assert_true(remove_file("/tmp/kol_io_moved.txt"), "remove")
assert_true(not file_exists("/tmp/kol_io_moved.txt"), "removed")
assert_true(remove_file("/tmp/kol_io_test.txt"), "cleanup")
assert_true(env_has("PATH"), "PATH set")
assert_eq_str(env_get_or("KOL_SURELY_UNSET_VAR", "dflt"), "dflt", "env fallback")
assert_true(current_dir().len() > 0, "cwd")
assert_eq_str(format_iso(0), "1970-01-01T00:00:00Z", "epoch")
assert_eq_str(format_iso(1700000000), "2023-11-14T22:13:20Z", "known ts")
assert_eq_int(weekday_of(1700000000), 2, "tuesday")
assert_eq_str(weekday_name(2), "Tuesday", "weekday_name")
assert_eq_str(month_name(11), "November", "month_name")
assert_true(is_leap_year(2024), "leap 2024")
assert_true(not is_leap_year(1900), "not leap 1900")
assert_true(is_leap_year(2000), "leap 2000")
assert_eq_int(days_in_month(2024, 2), 29, "feb 2024")
assert_eq_int(days_in_month(2023, 2), 28, "feb 2023")
let t0 = now_ms()
sleep_ms(20)
assert_true(elapsed_ms(t0) >= 15, "sleep elapsed")
assert_true(now_unix() > 1700000000, "now_unix sane")
assert_eq_str(path_join("a", "b"), "a/b", "join")
assert_eq_str(path_join("a/", "b"), "a/b", "join slash")
assert_eq_str(path_join("a", "/abs"), "/abs", "join abs")
assert_eq_str(path_basename("/x/y/file.tar.gz"), "file.tar.gz", "basename")
assert_eq_str(path_dirname("/x/y/file.txt"), "/x/y", "dirname")
assert_eq_str(path_dirname("file.txt"), ".", "dirname bare")
assert_eq_str(path_dirname("/file.txt"), "/", "dirname root")
assert_eq_str(path_extension("a/b.txt"), ".txt", "ext")
assert_eq_str(path_extension(".bashrc"), "", "dotfile ext")
assert_eq_str(path_stem("a/b.tar.gz"), "b.tar", "stem")
assert_true(path_is_absolute("/etc"), "abs")
print("IO OS TIME PATH TESTS PASSED")
