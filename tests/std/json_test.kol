use std.json
use std.core

mut obj = json_object_field("\{\}", "count", "42")
obj = json_object_field(obj, "ratio", "2.5")
obj = json_object_field(obj, "active", "true")
obj = json_object_field(obj, "zero", "0")
obj = json_object_field(obj, "zero_float", "0.0")
assert_eq_bool(json_is_valid(obj), true, "valid object")
assert_eq_int(json_get_int(obj, "count") or -1, 42, "typed int field")
assert_eq_float(json_get_float(obj, "ratio") or -1.0, 2.5, 0.000001, "typed float field")
assert_eq_bool(json_get_bool(obj, "active") or false, true, "typed bool field")
assert_eq_int(json_get_int_or(obj, "missing", 17), 17, "int fallback")
assert_eq_int(json_get_int_or(obj, "zero", 99), 0, "zero field does not use fallback")
assert_eq_float(json_get_float_or(obj, "missing", 3.25), 3.25, 0.000001, "float fallback")
assert_eq_float(json_get_float_or(obj, "zero_float", 9.0), 0.0, 0.000001, "zero float does not use fallback")
assert_eq_bool(json_get_bool_or(obj, "missing", true), true, "bool fallback")
assert_eq_bool(json_get_bool_or(obj, "active", false), true, "bool true is not replaced by fallback")
assert_eq_bool(json_get_bool_or(obj, "missing", false), false, "bool false fallback")
let arr = "[10,2.5,true,false,null]"
assert_eq_int(json_array_len(arr), 5, "array length")
assert_eq_int(json_array_get_int(arr, 0) or -1, 10, "array int")
assert_eq_float(json_array_get_float(arr, 1) or -1.0, 2.5, 0.000001, "array float")
assert_eq_bool(json_array_get_bool(arr, 2) or false, true, "array bool true")
assert_eq_bool(json_array_get_bool(arr, 3) or true, false, "array bool false")
assert_eq_int(json_array_get_int_or(arr, 4, 99), 99, "array invalid int fallback")
assert_eq_float(json_array_get_float_or(arr, 4, 1.5), 1.5, 0.000001, "array invalid float fallback")
assert_eq_float(json_array_get_float_or("[0.0]", 0, 1.5), 0.0, 0.000001, "array zero float does not use fallback")
assert_eq_bool(json_array_get_bool_or(arr, 4, false), false, "array invalid bool fallback")
assert_eq_bool(json_array_get_bool_or(arr, 3, true), false, "array false is not replaced by fallback")
assert_eq_int(json_array_get_int_or(arr, 99, 77), 77, "array out of range fallback")

mut typed_obj = "\{\}"
typed_obj = json_object_field_string(typed_obj, "message", "hello \"Kol\"\\world")
typed_obj = json_object_field_int(typed_obj, "count", 7)
typed_obj = json_object_field_float(typed_obj, "ratio", 1.5)
typed_obj = json_object_field_bool(typed_obj, "enabled", true)
assert_eq_bool(json_is_valid(typed_obj), true, "typed builders produce valid JSON")
assert_eq_str(json_get_string(typed_obj, "message"), "hello \"Kol\"\\world", "typed string builder escapes")
assert_eq_int(json_get_int(typed_obj, "count") or -1, 7, "typed int builder")
assert_eq_float(json_get_float(typed_obj, "ratio") or -1.0, 1.5, 0.000001, "typed float builder")
assert_eq_bool(json_get_bool(typed_obj, "enabled") or false, true, "typed bool builder")
assert_eq_str(json_get_string_or(typed_obj, "missing", "fallback"), "fallback", "string fallback")
mut typed_arr = "[]"
typed_arr = json_array_push_string(typed_arr, "quote: \"")
typed_arr = json_array_push_int(typed_arr, 12)
typed_arr = json_array_push_float(typed_arr, 2.25)
typed_arr = json_array_push_bool(typed_arr, false)
assert_eq_bool(json_is_valid(typed_arr), true, "typed array builders produce valid JSON")
assert_eq_int(json_array_len(typed_arr), 4, "typed array builder length")
assert_eq_str(json_array_get_string(typed_arr, 0) or "ERR", "quote: \"", "typed array string getter")
assert_eq_int(json_array_get_int(typed_arr, 1) or -1, 12, "typed array int getter")
assert_eq_float(json_array_get_float(typed_arr, 2) or -1.0, 2.25, 0.000001, "typed array float getter")
assert_eq_bool(json_array_get_bool(typed_arr, 3) or true, false, "typed array bool getter")

print("JSON TESTS PASSED")
