use std.core
assert_eq_str("a", "a", "ok")
assert_eq_float(1.0, 1.0001, 0.001, "float ok")
assert_eq_bool(true, true, "bool")
assert_true(in_range(5, 1, 10), "in_range")
assert_eq_int(min3(4, 2, 9), 2, "min3")
assert_eq_int(max3(4, 2, 9), 9, "max3")
assert_eq_int(div_floor(-7, 2), -4, "div_floor")
assert_eq_int(mod_floor(-7, 3), 2, "mod_floor")
assert_eq_int(div_floor(7, 2), 3, "div_floor pos")
print("CORE EXTRA TESTS PASSED")
