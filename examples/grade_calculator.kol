type Student
    name:  str
    score: int
    fn grade() -> str
        if self.score >= 90
            return "A"
        elif self.score >= 80
            return "B"
        elif self.score >= 70
            return "C"
        else
            return "F"
        end
    end
end
fn main()
    let students = [
        Student(name: "Alice", score: 95),
        Student(name: "Bob",   score: 82),
        Student(name: "Carol", score: 67)
    ]
    for s in students
        print("{s.name}: {s.grade()}")
    end
end
